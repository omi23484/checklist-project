Value Filldown VRF (\S+)
Value NEIGHBOR (\d+\.\d+\.\d+\.\d+)
Value INTERFACE (\S+)
Value UPTIME (\S+)
Value EXPIRES (\S+)
Value DR_PRIORITY (\d+)
Value BIDIR_CAPABLE (\S+)
Value BFD_STATE (\S+)

Start
  ^PIM Neighbor Status for VRF\s+"${VRF}" -> Neighbors
  ^. -> Continue

Neighbors
  ^PIM Neighbor Status for VRF\s+"${VRF}" -> Neighbors
  ^\s*${NEIGHBOR}\s+${INTERFACE}\s+${UPTIME}\s+${EXPIRES}\s+${DR_PRIORITY}\s+${BIDIR_CAPABLE}\s+${BFD_STATE} -> Record
  ^. -> Continue

EOF
