<group name="groups*">
{{ interface }} - Group {{ group }} - Address-Family {{ address_family }}
  State is {{ state }}
  Virtual IP address is {{ virtual_ip }}
  Virtual MAC address is {{ virtual_mac }}
  Advertisement interval is {{ adv_interval }} sec
  Preemption {{ preempt }}
  Priority is {{ priority }}
  Track object {{ track_object }} state {{ track_state }} decrement {{ track_decrement }}
  Master Router is {{ master_router | re("[^ ]+") }} (local), priority is {{ master_priority }}
  Master Router is {{ master_router | re("[^,]+") }}, priority is {{ master_priority }}
  Master Advertisement interval is {{ master_adv_interval }} sec
  Master Down interval is {{ master_down_interval }} sec (expires in {{ master_down_expires }} sec)
  Master Down interval is {{ master_down_interval }} sec
</group>
